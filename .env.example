# Ecobee API — get API key from https://www.ecobee.com/developers/
# The API key is NOT your email. It's a ~32 char string from the developer portal.
# The refresh token is obtained after the initial PIN authorization flow.
ECOBEE_API_KEY=your_ecobee_api_key_from_developer_portal
ECOBEE_REFRESH_TOKEN=your_ecobee_refresh_token

# Emporia Vue — your Emporia app login credentials
EMPORIA_EMAIL=your_emporia_email
EMPORIA_PASSWORD=your_emporia_password

# EG4 Monitor Portal — your monitor.eg4electronics.com login
# Use EG4_USERNAME for plain-username logins (e.g. pheltzel)
# Use EG4_EMAIL if your login is an email address — either works
EG4_USERNAME=your_eg4_username
# EG4_EMAIL=your_eg4_email_if_you_use_email_to_login
EG4_PASSWORD=your_eg4_password
# Optional: comma-separated inverter serial numbers as a fallback if
# the login response doesn't include them automatically.
# EG4_SERIAL_NUMBERS=2309XXXXXXX,2312XXXXXXX

# Server
PORT=3001
